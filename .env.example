# Copy to .env for local development, or set these in Render's dashboard.

# PostgreSQL connection. Render provides this automatically from the blueprint.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/montra

# Signs session tokens. MUST be set to a long random value in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Shared key the telematics platform uses on the ingestion endpoint.
TELEMATICS_API_KEY=change-me

# Apply schema + reference data on first boot if the database is empty.
MIGRATE_ON_START=false

# Also load the demonstration fleet. Never enable in production.
SEED_DEMO_DATA=false

# Hours of silence after which a telematics feed is treated as stale (BL-USG-003).
TELEMATICS_STALE_HOURS=48

PORT=3000
